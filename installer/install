#!/bin/bash

set -e

cd ../frontend
npm install
npm run build
cd ..

rm -rf backend/web
mkdir -p backend/web
cp -r frontend/dist/* backend/web/

rm -f backend/dnd
sudo rm -f "$INSTALL_DIR/dnd"

cd backend

go build -o dnd

INSTALL_DIR="$HOME/.local/share/dnd"
mkdir -p "$INSTALL_DIR"
cp dnd "$INSTALL_DIR/"

sudo chown root:root ~/.local/share/dnd/dnd
sudo chmod 4755 ~/.local/share/dnd/dnd

pkill -f "$INSTALL_DIR/dnd" 2>/dev/null || true
sleep 1

nohup "$INSTALL_DIR/dnd" > /tmp/dnd.log 2>&1 &

echo "Вирус"
