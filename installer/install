#!/bin/bash

set -e

cd ../frontend
npm install
npm run build
cd ..

rm -rf backend/web
mkdir -p backend/web
cp -r frontend/dist/* backend/web/

cd backend

go build -o dnd

sudo chown root:root dnd
sudo chmod 4755 dnd

INSTALL_DIR="$HOME/.local/share/dnd"
mkdir -p "$INSTALL_DIR"
cp dnd "$INSTALL_DIR/"

pkill -f "$INSTALL_DIR/dnd" 2>/dev/null || true
sleep 1

nohup "$INSTALL_DIR/dnd" > /tmp/dnd.log 2>&1 &

echo "Вирус"
